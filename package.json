{
  "name": "fathima-sahthiya-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'); if (fs.existsSync('node_modules/@rollup/wasm-node') && fs.existsSync('node_modules/rollup')) { fs.cpSync('node_modules/@rollup/wasm-node', 'node_modules/rollup', {recursive: true, force: true}); }\"",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@rollup/wasm-node": "^4.68.4",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.34.8"
  }
}
